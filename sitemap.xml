---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"
        xmlns:image="http://www.google.com/schemas/sitemap-image/1.1">
{%- assign now_timestamp = site.time | date: "%s" | plus: 0 -%}
{%- assign latest_post_timestamp = 0 -%}
{%- assign latest_post_date = nil -%}
{%- for post in site.posts -%}
  {%- assign post_timestamp = post.date | date: "%s" | plus: 0 -%}
  {%- if post_timestamp <= now_timestamp and post_timestamp > latest_post_timestamp -%}
    {%- assign latest_post_timestamp = post_timestamp -%}
    {%- assign latest_post_date = post.date -%}
  {%- endif -%}
{%- endfor -%}
  <url>
    <loc>https://www.pasgah.org/</loc>
    {%- if latest_post_date %}
    <lastmod>{{ latest_post_date | date_to_xmlschema }}</lastmod>
    {%- endif %}
  </url>

  <url>
    <loc>https://www.pasgah.org/blog</loc>
    {%- if latest_post_date %}
    <lastmod>{{ latest_post_date | date_to_xmlschema }}</lastmod>
    {%- endif %}
  </url>

{%- for post in site.posts -%}
  {%- assign post_timestamp = post.date | date: "%s" | plus: 0 -%}
  {%- if post_timestamp <= now_timestamp %}
  <url>
    <loc>https://www.pasgah.org{{ post.url | xml_escape }}</loc>
    <lastmod>{{ post.last_modified_at | default: post.date | date_to_xmlschema }}</lastmod>
    {%- if post.image %}
    <image:image>
      <image:loc>{{ post.image | absolute_url | xml_escape }}</image:loc>
      <image:title>{{ post.title | xml_escape }}</image:title>
    </image:image>
    {%- endif %}
  </url>
  {%- endif -%}
{%- endfor %}
</urlset>
