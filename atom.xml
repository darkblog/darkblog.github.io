---
layout: null
---

<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom">
  <title>پاسگاه</title>
  <link href="https://www.pasgah.org/" rel="alternate" type="text/html"/>
  <link href="https://www.pasgah.org/atom.xml" rel="self" type="application/atom+xml"/>
  <updated>{{ site.time | date_to_xmlschema }}</updated>
  <id>https://www.pasgah.org/</id>

  <author>
    <name>احسان چهری</name>
  </author>

  {% for post in site.posts limit:20 %}
  <entry>
    <title>{{ post.title | xml_escape }}</title>
    <link href="https://www.pasgah.org{{ post.url }}" rel="alternate" type="text/html"/>
    <updated>{{ post.date | date_to_xmlschema }}</updated>
    <id>https://www.pasgah.org{{ post.url }}</id>
    <summary type="html">{{ post.excerpt | strip_html | truncate: 300 | xml_escape }}</summary>
  </entry>
  {% endfor %}
</feed>
